{
  "name": "dsh-session-hub",
  "version": "0.1.1",
  "description": "DSH 会话能力插件：跨项目会话通信/管理/目标工具，设置页逐项开关，无侧栏入口。",
  "author": "Y77H",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "session",
    "session-manager",
    "session-messaging",
    "goal",
    "sidebar"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doraasn/dsh-session-hub.git"
  },
  "homepage": "https://github.com/doraasn/dsh-session-hub#readme",
  "bugs": {
    "url": "https://github.com/doraasn/dsh-session-hub/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
